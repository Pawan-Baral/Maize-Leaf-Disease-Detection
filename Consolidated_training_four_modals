def export_architecture(model_name, model, output_dir):
    architecture_dir = output_dir / "architecture"
    architecture_dir.mkdir(parents=True, exist_ok=True)
    backbone = find_backbone(model)

    with (architecture_dir / "model_summary.txt").open("w") as file:
        try:
            model.summary(
                print_fn=lambda line: file.write(line + "\n"),
                expand_nested=True,
                show_trainable=True,
            )
        except TypeError:
            model.summary(print_fn=lambda line: file.write(line + "\n"))

    with (architecture_dir / "model_config.json").open("w") as file:
        file.write(model.to_json(indent=2))

    save_layer_table(model.layers, architecture_dir / "top_level_layers.csv")
    save_layer_table(backbone.layers, architecture_dir / "backbone_layers.csv")

    # This requires pydot/Graphviz, normally available in Kaggle.
    try:
        tf.keras.utils.plot_model(
            model,
            to_file=str(architecture_dir / "keras_architecture.png"),
            show_shapes=True,
            show_layer_names=True,
            show_trainable=True,
            expand_nested=False,
            rankdir="LR",
            dpi=220,
        )
    except Exception as error:
        with (architecture_dir / "keras_plot_error.txt").open("w") as file:
            file.write(str(error))

    save_architecture_overview(
        model_name, model, backbone, architecture_dir
    )

    info = {
        "model": model_name,
        "input_shape": shape_text(model.input.shape),
        "backbone_output_shape": layer_output_shape(backbone),
        "global_average_pooling_output_shape": layer_output_shape(
            model.get_layer("global_average_pooling")
        ),
        "classifier_output_shape": layer_output_shape(
            model.get_layer("predictions")
        ),
        "total_parameters": int(model.count_params()),
        "trainable_parameters": int(
            sum(np.prod(weight.shape) for weight in model.trainable_weights)
        ),
        "non_trainable_parameters": int(
            sum(np.prod(weight.shape) for weight in model.non_trainable_weights)
        ),
        "pooling": "GlobalAveragePooling2D",
        "dropout_rate": DROPOUT_RATE,
        "classes": CLASS_NAMES,
    }
    with (architecture_dir / "architecture_info.json").open("w") as file:
        json.dump(info, file, indent=2)
    return info


