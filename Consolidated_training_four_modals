def resolve_required_class_directories():
    """Locate one and only one directory for every exact whitelisted name."""
    progress(
        "STAGE 2 — LOCATING DATA",
        "Searching for the four exact CORN_* class folders",
        include_resources=True,
    )
    if not DATASET_ROOT.exists():
        raise FileNotFoundError(
            f"Dataset not found at {DATASET_ROOT}. Attach "
            "yasirahmad0810/consolidated-corn-dataset and run again."
        )

    resolved = {}
    missing = []
    ambiguous = {}

    for folder_name, class_name in REQUIRED_CLASS_FOLDERS.items():
        matches = sorted(
            path
            for path in DATASET_ROOT.rglob(folder_name)
            if path.is_dir() and path.name == folder_name
        )
        if not matches:
            missing.append(folder_name)
        elif len(matches) > 1:
            ambiguous[folder_name] = [str(path) for path in matches]
        else:
            resolved[class_name] = matches[0].resolve()

    if missing:
        raise RuntimeError(
            "Required maize folder(s) not found under "
            f"{DATASET_ROOT}: {missing}. Folder names must match exactly."
        )
    if ambiguous:
        details = "\n".join(
            f"  {name}: {paths}" for name, paths in ambiguous.items()
        )
        raise RuntimeError(
            "More than one directory has a required folder name. "
            "Set DATASET_ROOT to the parent of the intended four folders:\n"
            f"{details}"
        )

    print("\nExact maize folders selected:")
    for class_name in CLASS_NAMES:
        print(f"  {class_name:18s} <- {resolved[class_name]}")
    print("All other dataset folders will be ignored.\n")
    return resolved


