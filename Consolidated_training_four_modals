def elapsed_text(seconds=None):
    seconds = time.perf_counter() - RUN_START_TIME if seconds is None else seconds
    seconds = max(0, int(seconds))
    hours, remainder = divmod(seconds, 3600)
    minutes, seconds = divmod(remainder, 60)
    return f"{hours:02d}:{minutes:02d}:{seconds:02d}"


def gpu_snapshot():
    """Return NVIDIA utilization when nvidia-smi is available on Kaggle."""
    command = [
        "nvidia-smi",
        "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
        "--format=csv,noheader,nounits",
    ]
    try:
        completed = subprocess.run(
            command,
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        )
        first_gpu = completed.stdout.strip().splitlines()[0]
        name, utilization, used, total, temperature = [
            value.strip() for value in first_gpu.split(",")
        ]
        return {
            "name": name,
            "utilization_percent": float(utilization),
            "memory_used_mb": float(used),
            "memory_total_mb": float(total),
            "temperature_c": float(temperature),
        }
    except Exception:
        return None


def resource_snapshot():
    snapshot = {
        "elapsed": elapsed_text(),
        "logical_cpu_count": os.cpu_count(),
    }
    if psutil is not None:
        memory = psutil.virtual_memory()
        process = psutil.Process(os.getpid())
        snapshot.update(
            {
                "physical_cpu_count": psutil.cpu_count(logical=False),
                "cpu_utilization_percent": psutil.cpu_percent(interval=None),
                "ram_used_gb": memory.used / (1024 ** 3),
                "ram_total_gb": memory.total / (1024 ** 3),
                "ram_utilization_percent": memory.percent,
                "process_ram_gb": process.memory_info().rss / (1024 ** 3),
            }
        )
    gpu = gpu_snapshot()
    if gpu is not None:
        snapshot["gpu"] = gpu
    try:
        tf_memory = tf.config.experimental.get_memory_info("GPU:0")
        snapshot["tensorflow_gpu_current_mb"] = tf_memory["current"] / (1024 ** 2)
        snapshot["tensorflow_gpu_peak_mb"] = tf_memory["peak"] / (1024 ** 2)
    except Exception:
        pass
    return snapshot


def format_resources(snapshot):
    parts = [f"elapsed {snapshot['elapsed']}"]
    if "cpu_utilization_percent" in snapshot:
        parts.append(
            f"CPU {snapshot['cpu_utilization_percent']:.1f}% "
            f"({snapshot.get('physical_cpu_count', '?')} physical / "
            f"{snapshot.get('logical_cpu_count', '?')} logical cores)"
        )
        parts.append(
            f"RAM {snapshot['ram_used_gb']:.1f}/{snapshot['ram_total_gb']:.1f} GB "
            f"({snapshot['ram_utilization_percent']:.1f}%)"
        )
        parts.append(f"process RAM {snapshot['process_ram_gb']:.2f} GB")
    gpu = snapshot.get("gpu")
    if gpu is not None:
        parts.append(
            f"GPU {gpu['name']} {gpu['utilization_percent']:.0f}%"
        )
        parts.append(
            f"GPU RAM {gpu['memory_used_mb']:.0f}/{gpu['memory_total_mb']:.0f} MB"
        )
        parts.append(f"GPU temp {gpu['temperature_c']:.0f} C")
    elif GPUS if "GPUS" in globals() else False:
        parts.append("GPU detected (nvidia-smi utilization unavailable)")
    return " | ".join(parts)


def progress(stage, message, include_resources=False, **extra):
    """Print, log, and save the most recent execution stage."""
    timestamp = datetime.now().astimezone().isoformat(timespec="seconds")
    line = f"[{timestamp}] [{elapsed_text()}] {stage}: {message}"
    snapshot = resource_snapshot() if include_resources else None
    if snapshot is not None:
        line += "\n    " + format_resources(snapshot)
    status = {
        "timestamp": timestamp,
        "elapsed": elapsed_text(),
        "stage": stage,
        "message": message,
        "resources": snapshot,
        **extra,
    }
    with _progress_lock:
        print("\n" + line, flush=True)
        with PROGRESS_LOG_PATH.open("a", encoding="utf-8") as file:
            file.write(line + "\n")
        STATUS_PATH.write_text(json.dumps(status, indent=2), encoding="utf-8")


class LiveResourceMonitor:
    """Print resource use while a long Kaggle operation is running."""

    def __init__(self, label):
        self.label = label
        self.stop_event = threading.Event()
        self.thread = None

    def start(self):
        if not SHOW_RESOURCE_MONITOR:
            return
        self.stop_event.clear()
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def _run(self):
        while not self.stop_event.wait(RESOURCE_MONITOR_INTERVAL_SECONDS):
            progress("RESOURCE MONITOR", self.label, include_resources=True)

    def stop(self):
        if self.thread is not None:
            self.stop_event.set()
            self.thread.join(timeout=5)
            self.thread = None


class EpochProgressCallback(tf.keras.callbacks.Callback):
    """Show exactly which phase/epoch is running and the resources it used."""

    def __init__(self, model_name, phase_name, first_epoch, total_phase_epochs):
        super().__init__()
        self.model_name = model_name
        self.phase_name = phase_name
        self.first_epoch = first_epoch
        self.total_phase_epochs = total_phase_epochs
        self.epoch_start = None
        self.monitor = None

    def on_train_begin(self, logs=None):
        self.monitor = LiveResourceMonitor(
            f"{self.model_name} / {self.phase_name} is training"
        )
        self.monitor.start()

    def on_epoch_begin(self, epoch, logs=None):
        self.epoch_start = time.perf_counter()
        phase_epoch = epoch - self.first_epoch + 1
        progress(
            "TRAINING",
            f"{self.model_name} | {self.phase_name} | "
            f"epoch {phase_epoch}/{self.total_phase_epochs} started",
            include_resources=True,
            model=self.model_name,
            phase=self.phase_name,
            epoch=phase_epoch,
            total_epochs=self.total_phase_epochs,
        )

    def on_epoch_end(self, epoch, logs=None):
        logs = logs or {}
        phase_epoch = epoch - self.first_epoch + 1
        duration = time.perf_counter() - self.epoch_start
        metric_text = ", ".join(
            f"{key}={float(value):.4f}"
            for key, value in logs.items()
            if isinstance(value, (int, float, np.integer, np.floating))
        )
        progress(
            "EPOCH COMPLETE",
            f"{self.model_name} | {self.phase_name} | "
            f"epoch {phase_epoch}/{self.total_phase_epochs} | "
            f"epoch time {elapsed_text(duration)} | {metric_text}",
            include_resources=True,
            model=self.model_name,
            phase=self.phase_name,
            epoch=phase_epoch,
            total_epochs=self.total_phase_epochs,
            metrics={key: float(value) for key, value in logs.items()},
        )

    def on_train_end(self, logs=None):
        if self.monitor is not None:
            self.monitor.stop()
        progress(
            "TRAINING PHASE COMPLETE",
            f"{self.model_name} | {self.phase_name}",
            include_resources=True,
        )


