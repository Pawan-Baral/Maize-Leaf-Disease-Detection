def validation_loss(checkpoint_path, valid_ds, model_name, phase_name):
    progress(
        "CHECKPOINT REVIEW",
        f"{model_name}: measuring validation loss for {phase_name}",
        include_resources=True,
        model=model_name,
    )
    candidate = tf.keras.models.load_model(
        str(checkpoint_path), compile=False
    )
    probabilities = candidate.predict(valid_ds, verbose=0)
    value = log_loss(
        valid_df["label"].to_numpy(),
        probabilities,
        labels=range(len(CLASS_NAMES)),
    )
    del candidate
    gc.collect()
    return float(value)


def train_one_model(model_name, model_number, total_models):
    model_start = time.perf_counter()
    progress(
        f"STAGE 4 — MODEL {model_number}/{total_models}",
        f"Starting {model_name}",
        include_resources=True,
        model=model_name,
        model_number=model_number,
        total_models=total_models,
    )

    tf.keras.backend.clear_session()
    gc.collect()
    seed_everything()

    config = MODEL_CONFIGS[model_name]
    batch_size = config["batch_size"]
    output_dir = WORK_ROOT / model_name
    checkpoint_dir = output_dir / "checkpoints"
    output_dir.mkdir(parents=True, exist_ok=True)
    checkpoint_dir.mkdir(parents=True, exist_ok=True)

    phase1_path = checkpoint_dir / f"{model_name}_phase1_best.keras"
    phase2_path = checkpoint_dir / f"{model_name}_phase2_best.keras"
    best_model_path = output_dir / f"{model_name}_best.keras"

    progress(
        "DATA PIPELINE",
        f"{model_name}: building train/validation/test pipelines; "
        f"batch size={batch_size}",
        include_resources=True,
        model=model_name,
    )
    train_ds = make_dataset(train_df, batch_size, training=True)
    valid_ds = make_dataset(valid_df, batch_size)
    test_ds = make_dataset(test_df, batch_size)

    progress(
        "MODEL BUILD",
        f"{model_name}: creating backbone and loading ImageNet weights",
        include_resources=True,
        model=model_name,
    )
    model, backbone = build_model(model_name)
    compile_model(model, LEARNING_RATE_PHASE1)
    progress(
        "MODEL READY",
        f"{model_name}: {model.count_params():,} total parameters; "
        f"{sum(np.prod(weight.shape) for weight in model.trainable_weights):,} "
        "trainable parameters",
        include_resources=True,
        model=model_name,
    )

    progress(
        "PHASE 1",
        f"{model_name}: frozen-backbone training for up to "
        f"{EPOCHS_PHASE1} epochs",
        include_resources=True,
        model=model_name,
    )
    history1 = model.fit(
        train_ds,
        validation_data=valid_ds,
        epochs=EPOCHS_PHASE1,
        class_weight=class_weights,
        callbacks=make_callbacks(
            phase1_path,
            output_dir / "phase1_log.csv",
            model_name,
            "phase 1 frozen backbone",
            0,
            EPOCHS_PHASE1,
        ),
        verbose=1,
    )
    with (output_dir / "history_phase1.json").open("w") as file:
        json.dump(history1.history, file, indent=2)

    fine_tune_start, number_unfrozen = configure_fine_tuning(backbone)
    compile_model(model, LEARNING_RATE_PHASE2)
    phase1_epochs_completed = len(history1.epoch)
    progress(
        "PHASE 2",
        f"{model_name}: fine-tuning the upper {number_unfrozen} of "
        f"{len(backbone.layers)} backbone layers "
        f"(starting at index {fine_tune_start}) for up to "
        f"{EPOCHS_PHASE2} epochs",
        include_resources=True,
        model=model_name,
    )
    history2 = model.fit(
        train_ds,
        validation_data=valid_ds,
        initial_epoch=phase1_epochs_completed,
        epochs=phase1_epochs_completed + EPOCHS_PHASE2,
        class_weight=class_weights,
        callbacks=make_callbacks(
            phase2_path,
            output_dir / "phase2_log.csv",
            model_name,
            "phase 2 fine-tuning",
            phase1_epochs_completed,
            EPOCHS_PHASE2,
        ),
        verbose=1,
    )
    with (output_dir / "history_phase2.json").open("w") as file:
        json.dump(history2.history, file, indent=2)

    del model, backbone
    gc.collect()
    tf.keras.backend.clear_session()

    phase1_val_loss = validation_loss(
        phase1_path, valid_ds, model_name, "phase 1"
    )
    phase2_val_loss = validation_loss(
        phase2_path, valid_ds, model_name, "phase 2"
    )
    if phase2_val_loss < phase1_val_loss:
        selected_path = phase2_path
        selected_phase = "fine-tuned"
    else:
        selected_path = phase1_path
        selected_phase = "frozen-backbone"

    selection = {
        "phase1_validation_loss": phase1_val_loss,
        "phase2_validation_loss": phase2_val_loss,
        "selected_phase": selected_phase,
        "fine_tune_start_index": fine_tune_start,
        "fine_tuned_backbone_layers": number_unfrozen,
    }
    with (output_dir / "checkpoint_selection.json").open("w") as file:
        json.dump(selection, file, indent=2)
    print("\nCheckpoint selection:", selection)

    progress(
        "BEST MODEL SELECTED",
        f"{model_name}: selected {selected_phase}; saving {best_model_path}",
        include_resources=True,
        model=model_name,
    )
    best_model = tf.keras.models.load_model(
        str(selected_path), compile=False
    )
    best_model.save(str(best_model_path))
    metrics = evaluate_and_save(
        model_name,
        best_model,
        test_ds,
        selected_phase,
        history1,
        history2,
        output_dir,
    )

    # Architecture is taken directly from the trained, selected model.
    progress(
        "ARCHITECTURE EXPORT",
        f"{model_name}: exporting exact implemented architecture",
        include_resources=True,
        model=model_name,
    )
    architecture_info = export_architecture(
        model_name, best_model, output_dir
    )

    result = {
        **metrics,
        **{
            "batch_size": batch_size,
            "backbone_output_shape": architecture_info[
                "backbone_output_shape"
            ],
            "pooled_output_shape": architecture_info[
                "global_average_pooling_output_shape"
            ],
            "total_parameters": architecture_info["total_parameters"],
            "best_model_path": str(best_model_path),
        },
    }

    del best_model, train_ds, valid_ds, test_ds
    gc.collect()
    tf.keras.backend.clear_session()
    progress(
        "MODEL COMPLETE",
        f"{model_name} finished in "
        f"{elapsed_text(time.perf_counter() - model_start)}; "
        f"outputs={output_dir}",
        include_resources=True,
        model=model_name,
    )
    return result


