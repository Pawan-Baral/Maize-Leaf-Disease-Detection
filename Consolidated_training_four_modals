def verify_gpu_execution():
    """Run and synchronize one real TensorFlow operation on GPU:0."""
    if not GPUS:
        return None
    with tf.device("/GPU:0"):
        left = tf.random.uniform((1024, 1024), dtype=tf.float32, seed=SEED)
        right = tf.random.uniform((1024, 1024), dtype=tf.float32, seed=SEED + 1)
        product = tf.matmul(left, right)
        checksum = float(tf.reduce_sum(product).numpy())
    return {"tensor_device": product.device, "checksum": checksum}


