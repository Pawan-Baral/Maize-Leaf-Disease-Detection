def per_class_diagnostics(test_labels, predictions, probabilities, cm):
    total = cm.sum()
    rows = []
    for index, class_name in enumerate(CLASS_NAMES):
        tp = float(cm[index, index])
        fn = float(cm[index, :].sum() - tp)
        fp = float(cm[:, index].sum() - tp)
        tn = float(total - tp - fn - fp)
        precision = tp / max(tp + fp, 1.0)
        recall = tp / max(tp + fn, 1.0)
        specificity = tn / max(tn + fp, 1.0)
        npv = tn / max(tn + fn, 1.0)
        f1 = 2 * precision * recall / max(precision + recall, 1e-12)
        binary_true = (test_labels == index).astype(int)
        rows.append(
            {
                "class": class_name,
                "support": int(tp + fn),
                "true_positive": int(tp),
                "false_negative": int(fn),
                "false_positive": int(fp),
                "true_negative": int(tn),
                "precision_ppv": precision,
                "recall_sensitivity": recall,
                "specificity_tnr": specificity,
                "f1_score": f1,
                "negative_predictive_value": npv,
                "false_positive_rate": fp / max(fp + tn, 1.0),
                "false_negative_rate": fn / max(fn + tp, 1.0),
                "one_vs_rest_accuracy": (tp + tn) / max(total, 1.0),
                "roc_auc_ovr": roc_auc_score(
                    binary_true, probabilities[:, index]
                ),
                "average_precision": average_precision_score(
                    binary_true, probabilities[:, index]
                ),
            }
        )
    return pd.DataFrame(rows)


def expected_calibration_error(test_labels, predictions, probabilities):
    confidence = probabilities.max(axis=1)
    correct = (predictions == test_labels).astype(float)
    edges = np.linspace(0.0, 1.0, CALIBRATION_BINS + 1)
    ece = 0.0
    rows = []
    for lower, upper in zip(edges[:-1], edges[1:]):
        if upper == 1.0:
            mask = (confidence >= lower) & (confidence <= upper)
        else:
            mask = (confidence >= lower) & (confidence < upper)
        count = int(mask.sum())
        if count == 0:
            continue
        bin_accuracy = float(correct[mask].mean())
        bin_confidence = float(confidence[mask].mean())
        ece += count / len(test_labels) * abs(bin_accuracy - bin_confidence)
        rows.append(
            {
                "lower_bound": lower,
                "upper_bound": upper,
                "samples": count,
                "mean_confidence": bin_confidence,
                "accuracy": bin_accuracy,
                "calibration_gap": bin_accuracy - bin_confidence,
            }
        )
    return float(ece), pd.DataFrame(rows)


def bootstrap_confidence_intervals(test_labels, predictions, probabilities):
    """Non-parametric 95% CIs from resampling the fixed test set."""
    rng = np.random.default_rng(SEED)
    samples = {
        "test_accuracy": [],
        "balanced_accuracy": [],
        "macro_precision": [],
        "macro_recall": [],
        "macro_f1": [],
        "macro_specificity": [],
        "matthews_correlation_coefficient": [],
        "cohen_kappa": [],
        "macro_roc_auc": [],
    }
    sample_count = len(test_labels)
    all_classes = np.arange(len(CLASS_NAMES))
    for _ in range(BOOTSTRAP_REPEATS):
        indices = rng.integers(0, sample_count, sample_count)
        y_true = test_labels[indices]
        y_pred = predictions[indices]
        y_prob = probabilities[indices]
        samples["test_accuracy"].append(accuracy_score(y_true, y_pred))
        samples["balanced_accuracy"].append(
            recall_score(
                y_true,
                y_pred,
                labels=all_classes,
                average="macro",
                zero_division=0,
            )
        )
        samples["macro_precision"].append(
            precision_score(
                y_true,
                y_pred,
                labels=all_classes,
                average="macro",
                zero_division=0,
            )
        )
        samples["macro_recall"].append(
            recall_score(
                y_true,
                y_pred,
                labels=all_classes,
                average="macro",
                zero_division=0,
            )
        )
        samples["macro_f1"].append(
            f1_score(
                y_true,
                y_pred,
                labels=all_classes,
                average="macro",
                zero_division=0,
            )
        )
        bootstrap_cm = confusion_matrix(
            y_true, y_pred, labels=all_classes
        )
        bootstrap_total = bootstrap_cm.sum()
        bootstrap_specificities = []
        for class_index in all_classes:
            tp = bootstrap_cm[class_index, class_index]
            fn = bootstrap_cm[class_index, :].sum() - tp
            fp = bootstrap_cm[:, class_index].sum() - tp
            tn = bootstrap_total - tp - fn - fp
            bootstrap_specificities.append(tn / max(tn + fp, 1))
        samples["macro_specificity"].append(
            float(np.mean(bootstrap_specificities))
        )
        samples["matthews_correlation_coefficient"].append(
            matthews_corrcoef(y_true, y_pred)
        )
        samples["cohen_kappa"].append(cohen_kappa_score(y_true, y_pred))
        if len(np.unique(y_true)) == len(CLASS_NAMES):
            bootstrap_binary = label_binarize(y_true, classes=all_classes)
            samples["macro_roc_auc"].append(
                roc_auc_score(
                    bootstrap_binary,
                    y_prob,
                    average="macro",
                    multi_class="ovr",
                )
            )

    alpha = (1.0 - CONFIDENCE_LEVEL) / 2.0
    rows = []
    for metric_name, values in samples.items():
        clean = np.asarray(values, dtype=float)
        clean = clean[np.isfinite(clean)]
        rows.append(
            {
                "metric": metric_name,
                "confidence_level": CONFIDENCE_LEVEL,
                "bootstrap_repeats": len(clean),
                "lower": float(np.quantile(clean, alpha)),
                "median": float(np.quantile(clean, 0.5)),
                "upper": float(np.quantile(clean, 1.0 - alpha)),
            }
        )
    return pd.DataFrame(rows)


def benchmark_model(model, test_ds):
    """Benchmark already-decoded tensors so storage speed is not measured."""
    batch_images, _ = next(iter(test_ds))
    single_image = batch_images[:1]

    for _ in range(5):
        model(batch_images, training=False).numpy()
        model(single_image, training=False).numpy()

    batch_times = []
    single_times = []
    for _ in range(BENCHMARK_REPEATS):
        start = time.perf_counter()
        model(batch_images, training=False).numpy()
        batch_times.append(time.perf_counter() - start)

        start = time.perf_counter()
        model(single_image, training=False).numpy()
        single_times.append(time.perf_counter() - start)

    batch_size = int(batch_images.shape[0])
    median_batch_seconds = float(np.median(batch_times))
    median_single_seconds = float(np.median(single_times))
    return {
        "benchmark_device": "GPU" if GPUS else "CPU",
        "benchmark_repeats": BENCHMARK_REPEATS,
        "benchmark_batch_size": batch_size,
        "median_batch_latency_ms": median_batch_seconds * 1000.0,
        "median_latency_per_image_in_batch_ms": (
            median_batch_seconds * 1000.0 / batch_size
        ),
        "median_single_image_latency_ms": median_single_seconds * 1000.0,
        "batch_throughput_images_per_second": (
            batch_size / median_batch_seconds
        ),
    }


def plot_roc_curves(model_name, test_labels, probabilities, output_dir):
    binary_labels = label_binarize(
        test_labels, classes=range(len(CLASS_NAMES))
    )
    fig, ax = plt.subplots(figsize=(7.2, 6.2))
    all_fpr = []
    class_curves = []
    for index, class_name in enumerate(CLASS_NAMES):
        fpr, tpr, _ = roc_curve(binary_labels[:, index], probabilities[:, index])
        class_auc = auc(fpr, tpr)
        class_curves.append((fpr, tpr))
        all_fpr.append(fpr)
        ax.plot(fpr, tpr, lw=1.8, label=f"{class_name} (AUC={class_auc:.3f})")

    common_fpr = np.unique(np.concatenate(all_fpr))
    mean_tpr = np.mean(
        [np.interp(common_fpr, fpr, tpr) for fpr, tpr in class_curves],
        axis=0,
    )
    macro_auc = auc(common_fpr, mean_tpr)
    micro_fpr, micro_tpr, _ = roc_curve(binary_labels.ravel(), probabilities.ravel())
    ax.plot(
        common_fpr,
        mean_tpr,
        color="black",
        lw=2.4,
        linestyle="--",
        label=f"Macro average (AUC={macro_auc:.3f})",
    )
    ax.plot(
        micro_fpr,
        micro_tpr,
        color="#666666",
        lw=2.0,
        linestyle=":",
        label=f"Micro average (AUC={auc(micro_fpr, micro_tpr):.3f})",
    )
    ax.plot([0, 1], [0, 1], color="gray", linestyle="--", linewidth=1)
    ax.set(
        xlabel="False-positive rate",
        ylabel="True-positive rate",
        title=f"{model_name} one-vs-rest ROC curves — test set",
        xlim=(0, 1),
        ylim=(0, 1.02),
    )
    ax.legend(fontsize=8, loc="lower right")
    fig.tight_layout()
    save_figure(fig, output_dir, "roc_curves")


def plot_precision_recall_curves(
    model_name, test_labels, probabilities, output_dir
):
    binary_labels = label_binarize(
        test_labels, classes=range(len(CLASS_NAMES))
    )
    fig, ax = plt.subplots(figsize=(7.2, 6.2))
    for index, class_name in enumerate(CLASS_NAMES):
        precision, recall, _ = precision_recall_curve(
            binary_labels[:, index], probabilities[:, index]
        )
        ap = average_precision_score(
            binary_labels[:, index], probabilities[:, index]
        )
        ax.plot(recall, precision, lw=1.8, label=f"{class_name} (AP={ap:.3f})")
    micro_precision, micro_recall, _ = precision_recall_curve(
        binary_labels.ravel(), probabilities.ravel()
    )
    micro_ap = average_precision_score(
        binary_labels, probabilities, average="micro"
    )
    ax.plot(
        micro_recall,
        micro_precision,
        color="black",
        linestyle="--",
        lw=2.4,
        label=f"Micro average (AP={micro_ap:.3f})",
    )
    prevalence = 1.0 / len(CLASS_NAMES)
    ax.axhline(prevalence, color="gray", linestyle=":", linewidth=1)
    ax.set(
        xlabel="Recall",
        ylabel="Precision",
        title=f"{model_name} precision–recall curves — test set",
        xlim=(0, 1),
        ylim=(0, 1.02),
    )
    ax.legend(fontsize=8, loc="lower left")
    fig.tight_layout()
    save_figure(fig, output_dir, "precision_recall_curves")


def plot_calibration(model_name, test_labels, probabilities, output_dir):
    fig, ax = plt.subplots(figsize=(7.0, 6.0))
    bin_edges = np.linspace(0.0, 1.0, CALIBRATION_BINS + 1)
    for index, class_name in enumerate(CLASS_NAMES):
        binary_true = (test_labels == index).astype(float)
        confidence = probabilities[:, index]
        means, fractions = [], []
        for lower, upper in zip(bin_edges[:-1], bin_edges[1:]):
            mask = (confidence >= lower) & (
                confidence <= upper if upper == 1.0 else confidence < upper
            )
            if mask.any():
                means.append(float(confidence[mask].mean()))
                fractions.append(float(binary_true[mask].mean()))
        ax.plot(means, fractions, marker="o", lw=1.5, label=class_name)
    ax.plot([0, 1], [0, 1], color="black", linestyle="--", label="Perfect")
    ax.set(
        xlabel="Mean predicted probability",
        ylabel="Observed frequency",
        title=f"{model_name} calibration curves — test set",
        xlim=(0, 1),
        ylim=(0, 1),
    )
    ax.legend(fontsize=8)
    fig.tight_layout()
    save_figure(fig, output_dir, "calibration_curves")


def plot_confidence_analysis(
    model_name, test_labels, predictions, probabilities, output_dir
):
    confidence = probabilities.max(axis=1)
    correct = predictions == test_labels
    order = np.argsort(-confidence)
    cumulative_accuracy = np.cumsum(correct[order]) / np.arange(1, len(order) + 1)
    coverage = np.arange(1, len(order) + 1) / len(order)

    fig, axes = plt.subplots(1, 2, figsize=(11, 4.3))
    axes[0].hist(
        confidence[correct], bins=15, alpha=0.70, label="Correct", color="#228833"
    )
    axes[0].hist(
        confidence[~correct], bins=15, alpha=0.70, label="Incorrect", color="#CC3311"
    )
    axes[0].set(xlabel="Maximum softmax probability", ylabel="Images", title="Confidence distribution")
    axes[0].legend()
    axes[1].plot(coverage, cumulative_accuracy, color="#4477AA", lw=2)
    axes[1].set(
        xlabel="Coverage (most-confident images retained)",
        ylabel="Accuracy",
        title="Risk–coverage behavior",
        xlim=(0, 1),
        ylim=(0, 1.02),
    )
    fig.suptitle(f"{model_name} confidence analysis — test set")
    fig.tight_layout()
    save_figure(fig, output_dir, "confidence_analysis")


def plot_misclassified_examples(
    model_name, predictions_table, output_dir
):
    errors = predictions_table[
        predictions_table["label"] != predictions_table["predicted_label"]
    ].sort_values("prediction_confidence", ascending=False)
    errors.to_csv(output_dir / "misclassified_predictions.csv", index=False)
    if errors.empty:
        (output_dir / "misclassified_examples.txt").write_text(
            "No test images were misclassified.\n"
        )
        return

    shown = errors.head(MAX_ERROR_EXAMPLES)
    columns = 4
    rows = int(np.ceil(len(shown) / columns))
    fig, axes = plt.subplots(rows, columns, figsize=(12, 3.25 * rows))
    axes = np.atleast_1d(axes).ravel()
    for axis, (_, item) in zip(axes, shown.iterrows()):
        with Image.open(item["filepath"]) as image:
            axis.imshow(image.convert("RGB"))
        axis.set_title(
            f"True: {item['class_name']}\nPred: {item['predicted_class']} "
            f"({item['prediction_confidence']:.2f})",
            fontsize=8,
        )
        axis.axis("off")
    for axis in axes[len(shown):]:
        axis.axis("off")
    fig.suptitle(f"{model_name}: highest-confidence test errors", fontsize=13)
    fig.tight_layout()
    save_figure(fig, output_dir, "misclassified_examples")


