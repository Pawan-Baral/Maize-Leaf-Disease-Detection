def shape_text(value):
    try:
        return str(tuple(value))
    except Exception:
        return str(value)


def layer_output_shape(layer):
    try:
        return shape_text(layer.output.shape)
    except Exception:
        try:
            return shape_text(layer.output_shape)
        except Exception:
            return "unknown"


def find_backbone(model):
    nested = [
        layer
        for layer in model.layers
        if isinstance(layer, tf.keras.Model)
        and layer.name != "data_augmentation"
    ]
    if not nested:
        raise RuntimeError("Could not locate the nested backbone model.")
    return max(nested, key=lambda layer: layer.count_params())


def save_layer_table(layers_to_save, output_path):
    rows = []
    for index, layer in enumerate(layers_to_save):
        rows.append(
            {
                "index": index,
                "layer_name": layer.name,
                "layer_type": layer.__class__.__name__,
                "output_shape": layer_output_shape(layer),
                "parameters": int(layer.count_params()),
                "trainable": bool(layer.trainable),
            }
        )
    pd.DataFrame(rows).to_csv(output_path, index=False)


