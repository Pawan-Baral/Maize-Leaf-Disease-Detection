def get_models_to_run():
    if RUN_MODE == "all":
        names = MODEL_ORDER
    elif RUN_MODE == "single":
        names = [SINGLE_MODEL]
    else:
        raise ValueError("RUN_MODE must be 'all' or 'single'")

    unknown = [name for name in names if name not in MODEL_CONFIGS]
    if unknown:
        raise ValueError(f"Unknown model name(s): {unknown}")
    return names


def make_augmentation():
    return tf.keras.Sequential(
        [
            layers.RandomFlip("horizontal", seed=SEED),
            layers.RandomRotation(0.08, fill_mode="reflect", seed=SEED + 1),
            layers.RandomZoom(0.15, fill_mode="reflect", seed=SEED + 2),
            layers.RandomTranslation(
                0.08, 0.08, fill_mode="reflect", seed=SEED + 3
            ),
            layers.RandomContrast(0.10, seed=SEED + 4),
        ],
        name="data_augmentation",
    )


def apply_preprocessing(x, model_name):
    """Apply exactly the preprocessing expected by the selected backbone."""
    if model_name == "MobileNetV2":
        return tf.keras.applications.mobilenet_v2.preprocess_input(x)
    if model_name == "ResNet50":
        return tf.keras.applications.resnet50.preprocess_input(x)
    if model_name in {"EfficientNetB0", "ConvNeXtTiny"}:
        # Their default application models contain input preprocessing and
        # expect float RGB pixels in [0, 255].
        return x
    raise ValueError(f"No preprocessing configured for {model_name}")


def build_model(model_name):
    config = MODEL_CONFIGS[model_name]
    constructor = getattr(
        tf.keras.applications, config["constructor_name"], None
    )
    if constructor is None:
        raise RuntimeError(
            f"{model_name} is unavailable in TensorFlow {tf.__version__}. "
            "Use a current Kaggle TensorFlow image and restart the notebook."
        )

    inputs = tf.keras.Input(shape=(*IMAGE_SIZE, 3), name="image")
    x = make_augmentation()(inputs)
    x = apply_preprocessing(x, model_name)

    backbone = constructor(
        input_shape=(*IMAGE_SIZE, 3),
        include_top=False,
        weights="imagenet",
    )
    backbone.trainable = False

    # training=False protects pretrained BatchNorm statistics during both
    # frozen training and fine-tuning.
    x = backbone(x, training=False)
    x = layers.GlobalAveragePooling2D(
        name="global_average_pooling"
    )(x)
    x = layers.Dropout(DROPOUT_RATE, name="classifier_dropout")(x)
    outputs = layers.Dense(
        len(CLASS_NAMES),
        activation="softmax",
        dtype="float32",
        name="predictions",
    )(x)

    model = tf.keras.Model(
        inputs,
        outputs,
        name=f"{model_name}_maize_classifier",
    )
    return model, backbone


def compile_model(model, learning_rate):
    model.compile(
        optimizer=tf.keras.optimizers.Adam(learning_rate=learning_rate),
        loss="sparse_categorical_crossentropy",
        metrics=["accuracy"],
    )


def make_callbacks(
    checkpoint_path,
    csv_log_path,
    model_name,
    phase_name,
    first_epoch,
    total_phase_epochs,
):
    return [
        EpochProgressCallback(
            model_name,
            phase_name,
            first_epoch,
            total_phase_epochs,
        ),
        tf.keras.callbacks.ModelCheckpoint(
            str(checkpoint_path),
            monitor="val_loss",
            mode="min",
            save_best_only=True,
            verbose=1,
        ),
        tf.keras.callbacks.EarlyStopping(
            monitor="val_loss",
            mode="min",
            patience=EARLY_STOPPING_PATIENCE,
            restore_best_weights=True,
            verbose=1,
        ),
        tf.keras.callbacks.ReduceLROnPlateau(
            monitor="val_loss",
            mode="min",
            factor=0.5,
            patience=2,
            min_lr=1e-7,
            verbose=1,
        ),
        tf.keras.callbacks.CSVLogger(str(csv_log_path), append=False),
        tf.keras.callbacks.TerminateOnNaN(),
    ]


def configure_fine_tuning(backbone):
    """Unfreeze the upper fraction while keeping BatchNorm frozen."""
    backbone.trainable = True
    total_layers = len(backbone.layers)
    number_to_unfreeze = max(1, int(total_layers * FINE_TUNE_FRACTION))
    fine_tune_start = total_layers - number_to_unfreeze

    for index, layer in enumerate(backbone.layers):
        layer.trainable = (
            index >= fine_tune_start
            and not isinstance(layer, layers.BatchNormalization)
        )
    return fine_tune_start, number_to_unfreeze


