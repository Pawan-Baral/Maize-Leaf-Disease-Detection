RESAMPLING = getattr(Image, "Resampling", Image)


def image_fingerprints(rgb_image):
    """Create a normalized exact hash and a 64-bit perceptual dHash."""
    normalized = rgb_image.resize(IMAGE_SIZE, RESAMPLING.BILINEAR)
    pixel_hash = hashlib.sha256(np.asarray(normalized).tobytes()).hexdigest()

    gray = rgb_image.convert("L").resize((9, 8), RESAMPLING.BILINEAR)
    values = np.asarray(gray)
    bits = values[:, 1:] > values[:, :-1]
    bit_string = "".join("1" if bit else "0" for bit in bits.ravel())
    perceptual_hash = f"{int(bit_string, 2):016x}"
    return pixel_hash, perceptual_hash


def build_clean_manifest():
    # Scan only the four resolved directories. No other folder is traversed.
    selected_images = []
    folder_image_counts = {}
    for class_name in CLASS_NAMES:
        class_directory = CLASS_DIRECTORIES[class_name]
        paths = sorted(
            path
            for path in class_directory.rglob("*")
            if path.is_file() and path.suffix.lower() in SUPPORTED_EXTENSIONS
        )
        folder_image_counts[class_name] = len(paths)
        selected_images.extend((path, class_name, class_directory) for path in paths)

    empty_folders = [
        class_name
        for class_name, count in folder_image_counts.items()
        if count == 0
    ]
    if empty_folders:
        raise RuntimeError(
            "No supported images were found in required class folder(s): "
            f"{empty_folders}"
        )

    rows = []
    skipped = {"corrupt": 0, "too_small": 0}
    progress(
        "STAGE 3 — CHECKING IMAGES",
        f"Validating and fingerprinting {len(selected_images):,} images",
        include_resources=True,
        images_total=len(selected_images),
    )
    scan_start = time.perf_counter()

    for number, (path, class_name, class_directory) in enumerate(
        selected_images, 1
    ):
        try:
            with Image.open(path) as image:
                image.load()
                rgb = image.convert("RGB")
                if min(rgb.size) < 64:
                    skipped["too_small"] += 1
                    continue
                pixel_hash, perceptual_hash = image_fingerprints(rgb)
        except (UnidentifiedImageError, OSError, ValueError):
            skipped["corrupt"] += 1
            continue

        rows.append(
            {
                "filepath": str(path),
                "class_name": class_name,
                "label": CLASS_TO_INDEX[class_name],
                "source_folder": class_directory.name,
                "source_directory": str(class_directory),
                "pixel_hash": pixel_hash,
                "perceptual_hash": perceptual_hash,
            }
        )

        if (
            number % IMAGE_SCAN_PROGRESS_EVERY == 0
            or number == len(selected_images)
        ):
            rate = number / max(time.perf_counter() - scan_start, 1e-6)
            remaining = (len(selected_images) - number) / max(rate, 1e-6)
            progress(
                "IMAGE SCAN",
                f"{number:,}/{len(selected_images):,} checked "
                f"({100 * number / len(selected_images):.1f}%); "
                f"about {elapsed_text(remaining)} remaining",
                include_resources=True,
                images_checked=number,
                images_total=len(selected_images),
            )

    data = pd.DataFrame(rows)
    if data.empty:
        raise RuntimeError("No usable images remained in the four required folders.")
    data = data.sort_values("filepath").reset_index(drop=True)

    # Conflicting duplicate groups are removed; same-class groups keep one copy.
    for hash_column in ["pixel_hash", "perceptual_hash"]:
        conflicting = (
            data.groupby(hash_column)["class_name"].transform("nunique") > 1
        )
        data = data.loc[~conflicting].copy()
        data = data.drop_duplicates(hash_column, keep="first")

    counts = data["class_name"].value_counts().reindex(CLASS_NAMES, fill_value=0)
    if (counts < 10).any():
        raise RuntimeError(f"Insufficient images after cleaning:\n{counts}")

    print("Skipped files:", skipped)
    print("Unique usable images:", len(data))
    print(counts)
    return data.reset_index(drop=True)


