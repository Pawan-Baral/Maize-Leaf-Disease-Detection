def create_split(data):
    if not np.isclose(TRAIN_RATIO + VALID_RATIO + TEST_RATIO, 1.0):
        raise ValueError("TRAIN_RATIO + VALID_RATIO + TEST_RATIO must equal 1")

    train_valid, test = train_test_split(
        data,
        test_size=TEST_RATIO,
        random_state=SEED,
        stratify=data["label"],
    )
    valid_fraction = VALID_RATIO / (TRAIN_RATIO + VALID_RATIO)
    train, valid = train_test_split(
        train_valid,
        test_size=valid_fraction,
        random_state=SEED,
        stratify=train_valid["label"],
    )

    return pd.concat(
        [
            train.assign(split="train"),
            valid.assign(split="valid"),
            test.assign(split="test"),
        ],
        ignore_index=True,
    )


def reusable_manifest_is_valid(path):
    if not path.exists():
        return False
    try:
        old = pd.read_csv(path)
        required = {
            "filepath",
            "class_name",
            "label",
            "source_folder",
            "source_directory",
            "pixel_hash",
            "perceptual_hash",
            "split",
        }
        if not (
            required.issubset(old.columns)
            and set(old["class_name"]) == set(CLASS_NAMES)
            and set(old["split"]) == {"train", "valid", "test"}
            and old["filepath"].map(lambda value: Path(value).exists()).all()
        ):
            return False

        expected_folder_for_class = {
            class_name: directory.name
            for class_name, directory in CLASS_DIRECTORIES.items()
        }
        expected_directory_for_class = {
            class_name: directory
            for class_name, directory in CLASS_DIRECTORIES.items()
        }

        for row in old.itertuples(index=False):
            class_name = row.class_name
            expected_directory = expected_directory_for_class.get(class_name)
            if expected_directory is None:
                return False
            if row.source_folder != expected_folder_for_class[class_name]:
                return False
            if Path(row.source_directory).resolve() != expected_directory:
                return False
            try:
                Path(row.filepath).resolve().relative_to(expected_directory)
            except ValueError:
                return False

        return True
    except Exception:
        return False


